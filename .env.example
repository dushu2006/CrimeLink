# ============================================================================
# CrimeLink — environment template
#
# Copy to `.env` in the repository root and edit.  Every variable is prefixed
# CRIMELINK_ (see backend/app/config.py).
#
# The embedded profile (the default when running `python run.py`) needs none
# of the infrastructure below; it runs on SQLite + in-memory NetworkX + local
# filesystem + in-process job runner.
#
# Secrets here are placeholders.  Generate real ones:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Never commit real API keys.  Never place secrets in source code.
# ============================================================================

# --------------------------------------------------------------------- CORE
CRIMELINK_PROFILE=embedded
CRIMELINK_ENVIRONMENT=dev
CRIMELINK_LOG_LEVEL=INFO
CRIMELINK_DEBUG=true
CRIMELINK_API_BASE_URL=http://127.0.0.1:8000

# Signs JWTs and the HMAC on local presigned URLs. Rotate deliberately.
CRIMELINK_SECRET_KEY=change-me-in-production-with-a-32-byte-random-value

# ----------------------------------------------------------------- DATABASES
# Backend selection: auto (follows profile), or an explicit adapter name.
CRIMELINK_RELATIONAL_BACKEND=auto
CRIMELINK_GRAPH_BACKEND=auto
CRIMELINK_OBJECT_STORE_BACKEND=auto
CRIMELINK_BROKER_BACKEND=auto

# --- POSTGRES (production profile)
CRIMELINK_POSTGRES_USER=crimelink
CRIMELINK_POSTGRES_PASSWORD=crimelink
CRIMELINK_POSTGRES_DB=crimelink
CRIMELINK_POSTGRES_DSN=postgresql+asyncpg://crimelink:crimelink@postgres:5432/crimelink
CRIMELINK_POSTGRES_DSN_SYNC=postgresql+psycopg2://crimelink:crimelink@postgres:5432/crimelink
CRIMELINK_POSTGRES_POOL_SIZE=10
CRIMELINK_POSTGRES_MAX_OVERFLOW=20

# --- NEO4J (production profile)
CRIMELINK_NEO4J_URI=bolt://neo4j:7687
CRIMELINK_NEO4J_USER=neo4j
CRIMELINK_NEO4J_PASSWORD=crimelink
CRIMELINK_NEO4J_DATABASE=neo4j
# Centrality is computed in Python; GDS is optional (Enterprise licence).
CRIMELINK_NEO4J_GDS_ENABLED=false

# --- REDIS / CELERY (production profile)
CRIMELINK_REDIS_URL=redis://redis:6379/0
CRIMELINK_CELERY_BROKER_URL=redis://redis:6379/1
CRIMELINK_CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- OBJECT STORAGE (MinIO in production, filesystem in embedded)
CRIMELINK_MINIO_ENDPOINT=minio:9000
CRIMELINK_MINIO_ACCESS_KEY=crimelink
CRIMELINK_MINIO_SECRET_KEY=crimelink
CRIMELINK_MINIO_SECURE=false
CRIMELINK_MINIO_BUCKET_DOCUMENTS=documents
CRIMELINK_MINIO_BUCKET_DERIVED=documents-derived
CRIMELINK_MINIO_BUCKET_AUDIT_ANCHOR=audit-anchor

# ------------------------------------------------------------------- SECURITY
CRIMELINK_ACCESS_TOKEN_TTL_MINUTES=15
CRIMELINK_REFRESH_TOKEN_TTL_HOURS=8
CRIMELINK_PASSWORD_MIN_LENGTH=10
CRIMELINK_LOGIN_LOCKOUT_THRESHOLD=5
CRIMELINK_LOGIN_LOCKOUT_MINUTES=30
CRIMELINK_RATE_LIMIT_PER_MINUTE=100
CRIMELINK_RATE_LIMIT_AUTH_PER_MINUTE=10
# Comma-separated. Set this to the real console origin in production.
CRIMELINK_CORS_ORIGINS=http://localhost,http://127.0.0.1:5173

# ------------------------------------------------------------------------ NLP
# auto -> NVIDIA NIM when NVIDIA_API_KEY is set, otherwise deterministic +
# heuristic provider (no model download, works fully offline).
CRIMELINK_NLP_PROVIDER=auto
#
# NVIDIA NIM (OpenAI-compatible) legacy key.  `python run.py` maps this onto
# CRIMELINK_AI_API_KEY automatically; when running the backend any other way
# (e.g. the containers), set CRIMELINK_AI_API_KEY yourself.  An AI role is
# available only when a key reaches it through configuration (its own
# CRIMELINK_AI_<ROLE>_API_KEY or the global CRIMELINK_AI_API_KEY); with every
# key blank the gateway returns a structured "unavailable" result and never
# calls a provider.
NVIDIA_API_KEY=
CRIMELINK_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
CRIMELINK_NIM_MODEL=deepseek-ai/deepseek-v4-pro-0813
CRIMELINK_NIM_TEMPERATURE=0.0
CRIMELINK_NIM_MAX_TOKENS=4096
CRIMELINK_NIM_TIMEOUT_S=90
CRIMELINK_NIM_DISABLE_THINKING=true
CRIMELINK_NIM_CONCURRENCY=2
# Model output is never trusted above this confidence (PRD 8.2).
CRIMELINK_NLP_MAX_CONFIDENCE=0.8

# ------------------------------------------------------------------------- AI
# Multi-model AI Gateway.  Each role can point at a DIFFERENT provider/model.
# Any *_API_KEY left blank means "unavailable for that role" — the gateway
# returns a structured "insufficient evidence" response and the system keeps
# working fully offline on heuristic NLP.
#
# Defaults point all roles at NVIDIA NIM using AI_API_KEY (which also accepts
# NVIDIA_API_KEY for convenience).  Override per-role if needed.
CRIMELINK_AI_PROVIDER=nvidia
CRIMELINK_AI_API_KEY=
CRIMELINK_AI_BASE_URL=https://integrate.api.nvidia.com/v1
CRIMELINK_AI_TEMPERATURE=0.1
CRIMELINK_AI_MAX_TOKENS=2048
CRIMELINK_AI_TIMEOUT_S=90
# Never send raw PII unless an operator makes a conscious policy decision.
CRIMELINK_AI_ALLOW_RAW_PII=false
CRIMELINK_AI_PSEUDONYMIZE=true
# Whether to persist raw prompts in the audit log (default: hash only).
CRIMELINK_AI_AUDIT_PROMPT_STORAGE=false

# Extraction (NER/relation extraction from documents)
CRIMELINK_AI_EXTRACTION_MODEL=deepseek-ai/deepseek-v4-pro-0813
CRIMELINK_AI_EXTRACTION_PROVIDER=default
CRIMELINK_AI_EXTRACTION_API_KEY=
CRIMELINK_AI_EXTRACTION_BASE_URL=

# Reasoning (multi-hop investigation, hypothesis generation, evidence synthesis)
CRIMELINK_AI_REASONING_MODEL=deepseek-ai/deepseek-v4-pro-0813
CRIMELINK_AI_REASONING_PROVIDER=default
CRIMELINK_AI_REASONING_API_KEY=
CRIMELINK_AI_REASONING_BASE_URL=

# Explanation (investigator-friendly summaries with "why this matters")
CRIMELINK_AI_EXPLANATION_MODEL=meta/llama-3.1-8b-instruct
CRIMELINK_AI_EXPLANATION_PROVIDER=default
CRIMELINK_AI_EXPLANATION_API_KEY=
CRIMELINK_AI_EXPLANATION_BASE_URL=

# Classification (lightweight prioritization, anomaly triage, relevance scoring)
CRIMELINK_AI_CLASSIFICATION_MODEL=meta/llama-3.1-8b-instruct
CRIMELINK_AI_CLASSIFICATION_PROVIDER=default
CRIMELINK_AI_CLASSIFICATION_API_KEY=
CRIMELINK_AI_CLASSIFICATION_BASE_URL=

# Embedding (semantic search, duplicate/near-duplicate detection)
CRIMELINK_AI_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
CRIMELINK_AI_EMBEDDING_PROVIDER=default
CRIMELINK_AI_EMBEDDING_API_KEY=
CRIMELINK_AI_EMBEDDING_BASE_URL=

# ---------------------------------------------------------- SYNTHETIC CORPUS
# Synthetic development corpus.  This is a realistic stand-in for the shape
# and messiness of external police data.  It is NOT demo data and is NOT
# represented as real police data.  Every record carries source_environment=
# synthetic for downstream provenance tracking.
#
# The corpus is ingested EXPLICITLY via one of:
#   python -m app.cli ingest-synthetic               (mode selected below)
#   python -m app.synthetic_corpus.generate          (generate with defaults)
#   python -m app.synthetic_corpus.generate --stats  (show current counts)
#   python -m app.synthetic_corpus.generate --clear  (DEV ONLY: wipe DB)
#   python -m app.synthetic_corpus.external          (ingest external corpus)
#   python -m app.synthetic_corpus.external --dry-run (validate only)
#
# Synthetic data mode:
#   generate -> deterministic in-process generator (below); no files needed.
#   external -> read the local corpus directory from the filesystem.
# Development default is external. Nothing is ingested at application startup.
CRIMELINK_SYNTHETIC_DATA_MODE=external
#
# Root of the external synthetic corpus. Only its operational/ and documents/
# subdirectories are ingestion sources; ground_truth/ is evaluation-only and
# metadata/ is never imported as operational records.
# Relative paths resolve against the CrimeLink repository root.
# The local synthetic corpus lives at backend/CrimeLink_Synthetic_Corpus_v1/.
# The corpus is fully synthetic and is tracked in the repository.
# Absolute paths are honoured verbatim. Do NOT hard-code machine-specific
# user home paths here.
CRIMELINK_SYNTHETIC_DATA_ROOT=backend/CrimeLink_Synthetic_Corpus_v1
CRIMELINK_SYNTHETIC_CORPUS_ENABLED=false
CRIMELINK_SYNTHETIC_CORPUS_SEED=20260902
CRIMELINK_SYNTHETIC_CORPUS_VERSION=1
CRIMELINK_SYNTHETIC_PERSON_COUNT=60
CRIMELINK_SYNTHETIC_CASE_COUNT=12
CRIMELINK_SYNTHETIC_PHONE_COUNT=75
CRIMELINK_SYNTHETIC_VEHICLE_COUNT=30
CRIMELINK_SYNTHETIC_LOCATION_COUNT=25
CRIMELINK_SYNTHETIC_ACCOUNT_COUNT=35
CRIMELINK_SYNTHETIC_ORGANIZATION_COUNT=12
CRIMELINK_SYNTHETIC_DOCUMENT_COUNT=60
CRIMELINK_SYNTHETIC_CALL_COUNT=350
CRIMELINK_SYNTHETIC_TRANSACTION_COUNT=180
CRIMELINK_SYNTHETIC_BRIDGE_COUNT=4
CRIMELINK_SYNTHETIC_NETWORK_COUNT=3
CRIMELINK_SYNTHETIC_MISSING_FIELD_RATE=0.12
CRIMELINK_SYNTHETIC_DUPLICATE_RATE=0.08
CRIMELINK_SYNTHETIC_NAME_VARIATION_RATE=0.15

# ----------------------------------------------------- ENTITY RESOLUTION
CRIMELINK_ER_FUZZY_THRESHOLD=0.85
CRIMELINK_ER_MAX_PAIRS_PER_DOCUMENT=200
CRIMELINK_ER_QUEUE_SLA_HOURS=48

# ----------------------------------------------------- PATTERN DETECTION
CRIMELINK_STRUCTURING_MIN_TRANSFERS=4
CRIMELINK_STRUCTURING_WINDOW_DAYS=30
CRIMELINK_STRUCTURING_MAX_SINGLE_AMOUNT=50000
CRIMELINK_STRUCTURING_MIN_TOTAL_AMOUNT=1000000
CRIMELINK_BURNER_MAX_LIFESPAN_DAYS=21
CRIMELINK_BURNER_MIN_FANOUT=15
CRIMELINK_RAPID_MOVEMENT_MIN_KMH=110
CRIMELINK_NETWORK_BRIDGE_PERCENTILE=95
CRIMELINK_PATTERN_DISMISSAL_RATE_ALERT=0.70

# ---------------------------------------------------------- APPLICATION
CRIMELINK_PRESIGNED_URL_TTL_SECONDS=900
CRIMELINK_UPLOAD_MAX_BYTES=67108864
CRIMELINK_GRAPH_MAX_EXPAND_DEPTH=2
CRIMELINK_GRAPH_EXPAND_NODE_LIMIT=300
CRIMELINK_TEMPORAL_PATH_MAX_DEPTH=4
CRIMELINK_EXPORT_WATERMARK=CrimeLink — CONFIDENTIAL / LAW ENFORCEMENT USE ONLY
CRIMELINK_AUDIT_ANCHOR_ENABLED=true
CRIMELINK_RETENTION_DAYS_AFTER_CLOSURE=90

# Port the console is published on by `docker compose up`.
CRIMELINK_HTTP_PORT=80

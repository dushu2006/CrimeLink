# CrimeLink — environment template
#
# Copy to `.env` and edit.  Every variable is prefixed CRIMELINK_ (see
# backend/app/config.py).  The embedded profile used for local development
# needs none of this; the values below matter for `docker compose up`.
#
# Secrets here are placeholders.  Generate real ones:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --------------------------------------------------------------------- core
CRIMELINK_PROFILE=production
CRIMELINK_ENVIRONMENT=production
CRIMELINK_LOG_LEVEL=INFO
CRIMELINK_DEBUG=false

# Signs JWTs and the HMAC on local presigned URLs. Rotating it invalidates
# every session — do it deliberately, and only from here.
CRIMELINK_SECRET_KEY=change-me-in-production-with-a-32-byte-random-value

# ------------------------------------------------------------- persistence
# Backend selection: auto (follows profile), or an explicit adapter name —
# which is how a district can run Postgres but keep the embedded graph.
CRIMELINK_RELATIONAL_BACKEND=auto
CRIMELINK_GRAPH_BACKEND=auto
CRIMELINK_OBJECT_STORE_BACKEND=auto
CRIMELINK_BROKER_BACKEND=auto

CRIMELINK_POSTGRES_USER=crimelink
CRIMELINK_POSTGRES_PASSWORD=crimelink
CRIMELINK_POSTGRES_DB=crimelink
CRIMELINK_POSTGRES_DSN=postgresql+asyncpg://crimelink:crimelink@postgres:5432/crimelink
CRIMELINK_POSTGRES_DSN_SYNC=postgresql+psycopg2://crimelink:crimelink@postgres:5432/crimelink
CRIMELINK_POSTGRES_POOL_SIZE=10
CRIMELINK_POSTGRES_MAX_OVERFLOW=20

CRIMELINK_NEO4J_URI=bolt://neo4j:7687
CRIMELINK_NEO4J_USER=neo4j
CRIMELINK_NEO4J_PASSWORD=crimelink
CRIMELINK_NEO4J_DATABASE=neo4j
# CrimeLink computes centrality deterministically in Python, so GDS is
# optional. Leave this off unless you hold a Neo4j Enterprise licence.
CRIMELINK_NEO4J_GDS_ENABLED=false

CRIMELINK_REDIS_URL=redis://redis:6379/0
CRIMELINK_CELERY_BROKER_URL=redis://redis:6379/1
CRIMELINK_CELERY_RESULT_BACKEND=redis://redis:6379/2

CRIMELINK_MINIO_ENDPOINT=minio:9000
CRIMELINK_MINIO_ACCESS_KEY=crimelink
CRIMELINK_MINIO_SECRET_KEY=crimelink
CRIMELINK_MINIO_SECURE=false
CRIMELINK_MINIO_BUCKET_DOCUMENTS=documents
CRIMELINK_MINIO_BUCKET_DERIVED=documents-derived
CRIMELINK_MINIO_BUCKET_AUDIT_ANCHOR=audit-anchor

# ---------------------------------------------------------------- security
CRIMELINK_ACCESS_TOKEN_TTL_MINUTES=15
CRIMELINK_REFRESH_TOKEN_TTL_HOURS=8
CRIMELINK_PASSWORD_MIN_LENGTH=10
CRIMELINK_LOGIN_LOCKOUT_THRESHOLD=5
CRIMELINK_LOGIN_LOCKOUT_MINUTES=30
CRIMELINK_RATE_LIMIT_PER_MINUTE=100
CRIMELINK_RATE_LIMIT_AUTH_PER_MINUTE=10
# Comma-separated. Set this to the real console origin in production.
CRIMELINK_CORS_ORIGINS=http://localhost

# --------------------------------------------------------------------- NLP
# auto -> NVIDIA NIM when NVIDIA_API_KEY is set, otherwise the deterministic
# + heuristic provider (no model download, works fully offline).
CRIMELINK_NLP_PROVIDER=auto
#
# NVIDIA NIM (OpenAI-compatible).  Obtain the key from build.nvidia.com and
# export it; it is read from the environment, never committed.
NVIDIA_API_KEY=
CRIMELINK_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
CRIMELINK_NIM_MODEL=deepseek-ai/deepseek-v4-pro-0813
CRIMELINK_NIM_TEMPERATURE=0.0
CRIMELINK_NIM_MAX_TOKENS=4096
CRIMELINK_NIM_TIMEOUT_S=90
CRIMELINK_NIM_DISABLE_THINKING=true
CRIMELINK_NIM_CONCURRENCY=2
# PRD 8.2: model output is never trusted above this confidence.
CRIMELINK_NLP_MAX_CONFIDENCE=0.8

# -------------------------------------------------------- entity resolution
CRIMELINK_ER_FUZZY_THRESHOLD=0.85
CRIMELINK_ER_MAX_PAIRS_PER_DOCUMENT=200
CRIMELINK_ER_QUEUE_SLA_HOURS=48

# ------------------------------------------------------ pattern detection
CRIMELINK_STRUCTURING_MIN_TRANSFERS=4
CRIMELINK_STRUCTURING_WINDOW_DAYS=30
CRIMELINK_STRUCTURING_MAX_SINGLE_AMOUNT=50000
CRIMELINK_STRUCTURING_MIN_TOTAL_AMOUNT=1000000
CRIMELINK_BURNER_MAX_LIFESPAN_DAYS=21
CRIMELINK_BURNER_MIN_FANOUT=15
CRIMELINK_RAPID_MOVEMENT_MIN_KMH=110
CRIMELINK_NETWORK_BRIDGE_PERCENTILE=95
CRIMELINK_PATTERN_DISMISSAL_RATE_ALERT=0.70

# ------------------------------------------------------------------- misc
CRIMELINK_PRESIGNED_URL_TTL_SECONDS=900
CRIMELINK_UPLOAD_MAX_BYTES=67108864
CRIMELINK_GRAPH_MAX_EXPAND_DEPTH=2
CRIMELINK_GRAPH_EXPAND_NODE_LIMIT=300
CRIMELINK_TEMPORAL_PATH_MAX_DEPTH=4
CRIMELINK_EXPORT_WATERMARK=CrimeLink — CONFIDENTIAL / LAW ENFORCEMENT USE ONLY
# Nightly hash of the audit chain head into a separate object-store bucket.
CRIMELINK_AUDIT_ANCHOR_ENABLED=true
CRIMELINK_RETENTION_DAYS_AFTER_CLOSURE=90

# Port the console is published on by `docker compose up`.
CRIMELINK_HTTP_PORT=80

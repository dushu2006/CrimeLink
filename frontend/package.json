{
  "name": "crimelink-console",
  "private": true,
  "version": "1.0.0",
  "description": "CrimeLink investigator console — React + Cytoscape + Zustand",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc -b",
    "smoke": "npm run build && node smoke.mjs"
  },
  "dependencies": {
    "cytoscape": "3.30.2",
    "cytoscape-fcose": "2.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/cytoscape": "3.21.8",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}

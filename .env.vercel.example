# CrimeLink Vercel deployment environment template
#
# This file is documentation only. Vercel does not read example files: add the
# variables below in the Vercel project for the frontend and backend services
# (or add them at project scope). Replace every <...> placeholder before the
# first deployment. Never commit the resulting values.
#
# The Vercel deployment uses the existing production adapters. It does not use
# Docker Compose hostnames, SQLite, or local object storage as a durable system
# of record. The writable local paths below are only ephemeral workspace paths.
# PostgreSQL, Neo4j, and S3-compatible object storage must be reachable from
# Vercel for the seeded cases, graph, and evidence flows. Full background-job
# parity additionally uses Redis/Celery; the existing inline broker can be
# selected for a pre-seeded, read-focused judge deployment when those job flows
# are not part of the demo (see the Redis/Celery section below).

# --------------------------------------------------------------------- CORE
CRIMELINK_PROFILE=production
CRIMELINK_ENVIRONMENT=production
CRIMELINK_RUNTIME_CONTEXT=production
CRIMELINK_DEBUG=false
CRIMELINK_LOG_LEVEL=INFO
CRIMELINK_SECRET_KEY=<generate-a-unique-32-plus-character-secret>
CRIMELINK_CORS_ORIGINS=https://<your-vercel-domain>
# Optional but recommended; include any custom domain used for the console.
CRIMELINK_TRUSTED_HOSTS=*.vercel.app,<your-custom-domain>
# Vercel's filesystem is ephemeral. These paths are only writable transient
# workspace locations; PostgreSQL and S3-compatible storage remain durable.
CRIMELINK_DATA_DIR=/tmp/crimelink-data
CRIMELINK_OBJECT_STORE_DIR=/tmp/crimelink-objects

# -------------------------------------------------------------- PostgreSQL
# Use the same database for both URLs. The async URL is used by FastAPI; the
# sync URL is used by Alembic and worker code. Do not use the hostname postgres.
CRIMELINK_POSTGRES_DSN=postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
CRIMELINK_POSTGRES_DSN_SYNC=postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
CRIMELINK_POSTGRES_POOL_SIZE=5
CRIMELINK_POSTGRES_MAX_OVERFLOW=5

# ------------------------------------------------------------------ Neo4j
# Accepted names per field (first match wins; CRIMELINK_ always wins when
# both are set):
#   URI      CRIMELINK_NEO4J_URI, NEO4J_URI, NEO4J_CONNECTION_URI, NEO4J_URL
#   user     CRIMELINK_NEO4J_USER, NEO4J_USER, NEO4J_USERNAME
#   password CRIMELINK_NEO4J_PASSWORD, NEO4J_PASSWORD  (or NEO4J_AUTH=user:pass)
#   database CRIMELINK_NEO4J_DATABASE, NEO4J_DATABASE
#
# For Neo4j Aura the database and user are the instance id from the URI
# (neo4j+s://<instance>.databases.neo4j.io): when only NEO4J_URI is set,
# both are derived from it, so the old failure mode — connecting to a
# database literally named "neo4j" (22N51) — is impossible. Setting the
# variables explicitly, as below, is still the recommended form.
CRIMELINK_NEO4J_URI=bolt+s://<neo4j-host>:<port>
CRIMELINK_NEO4J_USER=<neo4j-user>
CRIMELINK_NEO4J_PASSWORD=<neo4j-password>
CRIMELINK_NEO4J_DATABASE=<neo4j-database>
CRIMELINK_NEO4J_GDS_ENABLED=false

# ------------------------------------------------------------ Redis/Celery
# In production, "auto" resolves the broker to Celery. Keep the explicit
# value below for full job/import, scheduled-task, distributed-rate-limit, and
# cross-instance event-bus behavior. A persistent worker and beat process must
# run outside Vercel against these URLs; a Vercel function is not a worker.
CRIMELINK_BROKER_BACKEND=celery
CRIMELINK_REDIS_URL=rediss://<redis-user>:<redis-password>@<redis-host>:<port>/0
CRIMELINK_CELERY_BROKER_URL=rediss://<redis-user>:<redis-password>@<redis-host>:<port>/1
CRIMELINK_CELERY_RESULT_BACKEND=rediss://<redis-user>:<redis-password>@<redis-host>:<port>/2

# Minimum pre-seeded/read-focused judge deployment: use the existing inline
# adapter instead of Celery and omit the three Redis URL variables above.
# This does not mock or remove jobs; it keeps them in-process and therefore
# does not provide durable background execution across Vercel instances.
# CRIMELINK_BROKER_BACKEND=inline
# Redis URL is also accepted as REDIS_URL (and REDIS_URI).

# ---------------------------------------------------------- Object storage
# The application expects its existing S3-compatible/MinIO adapter.
# Accepted names (CRIMELINK_ wins when both are set):
#   endpoint CRIMELINK_MINIO_ENDPOINT, S3_ENDPOINT, S3_ENDPOINT_URL,
#            MINIO_ENDPOINT, MINIO_SERVER, AWS_ENDPOINT_URL
#   access   CRIMELINK_MINIO_ACCESS_KEY, S3_ACCESS_KEY_ID, S3_ACCESS_KEY,
#            MINIO_ACCESS_KEY, MINIO_ACCESS_KEY_ID, AWS_ACCESS_KEY_ID
#   secret   CRIMELINK_MINIO_SECRET_KEY, S3_SECRET_ACCESS_KEY, S3_SECRET_KEY,
#            MINIO_SECRET_KEY, MINIO_SECRET_ACCESS_KEY, AWS_SECRET_ACCESS_KEY
#
# The endpoint is a bare host[:port] plus the SECURE flag — an AWS-style URL
# (https://s3.region.amazonaws.com) is normalised automatically: the scheme
# is stripped and TLS is enabled when it was https.
CRIMELINK_MINIO_ENDPOINT=<s3-compatible-host>:<port>
CRIMELINK_MINIO_ACCESS_KEY=<object-storage-access-key>
CRIMELINK_MINIO_SECRET_KEY=<object-storage-secret>
CRIMELINK_MINIO_SECURE=true
CRIMELINK_MINIO_BUCKET_DOCUMENTS=documents
CRIMELINK_MINIO_BUCKET_DERIVED=documents-derived
CRIMELINK_MINIO_BUCKET_AUDIT_ANCHOR=audit-anchor

# ----------------------------------------------------------------------- NLP
# Optional. With auto (the existing default), the NIM adapter is selected when
# one of these keys is present; otherwise the existing deterministic/heuristic
# fallback remains in place. NVIDIA_API_KEY is retained for the adapter's
# documented legacy fallback.
CRIMELINK_NLP_PROVIDER=auto
CRIMELINK_NIM_API_KEY=<nim-api-key>
NVIDIA_API_KEY=<legacy-nim-api-key>
CRIMELINK_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
CRIMELINK_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# ----------------------------------------------------------------------- AI
# Optional. If these are omitted, the existing structured unavailable/fallback
# behavior remains in place. Set the shared key or role-specific keys; do not
# place credentials in source code.
CRIMELINK_AI_PROVIDER=nvidia
CRIMELINK_AI_API_KEY=<ai-provider-api-key>
CRIMELINK_AI_BASE_URL=https://integrate.api.nvidia.com/v1
CRIMELINK_AI_EXTRACTION_MODEL=nvidia/nemotron-3-super-120b-a12b
CRIMELINK_AI_EXTRACTION_PROVIDER=default
CRIMELINK_AI_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
CRIMELINK_AI_REASONING_PROVIDER=default
CRIMELINK_AI_EXPLANATION_MODEL=meta/llama-3.2-11b-vision-instruct
CRIMELINK_AI_EXPLANATION_PROVIDER=default
CRIMELINK_AI_CLASSIFICATION_MODEL=meta/llama-3.2-11b-vision-instruct
CRIMELINK_AI_CLASSIFICATION_PROVIDER=default
CRIMELINK_AI_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
CRIMELINK_AI_EMBEDDING_PROVIDER=default
# Optional per-role overrides; leave unset to inherit the shared AI settings.
# CRIMELINK_AI_EXTRACTION_API_KEY
# CRIMELINK_AI_EXTRACTION_BASE_URL
# CRIMELINK_AI_REASONING_API_KEY
# CRIMELINK_AI_REASONING_BASE_URL
# CRIMELINK_AI_EXPLANATION_API_KEY
# CRIMELINK_AI_EXPLANATION_BASE_URL
# CRIMELINK_AI_CLASSIFICATION_API_KEY
# CRIMELINK_AI_CLASSIFICATION_BASE_URL
# CRIMELINK_AI_EMBEDDING_API_KEY
# CRIMELINK_AI_EMBEDDING_BASE_URL
CRIMELINK_AI_ALLOW_RAW_PII=false
CRIMELINK_AI_PSEUDONYMIZE=true
CRIMELINK_AI_AUDIT_PROMPT_STORAGE=false

# ------------------------------------------------------------- Optional app
# These retain application defaults when omitted; set them only when your
# deployment needs an override.
# CRIMELINK_ACCESS_TOKEN_TTL_MINUTES=15
# CRIMELINK_REFRESH_TOKEN_TTL_HOURS=8
# CRIMELINK_RATE_LIMIT_PER_MINUTE=100
# CRIMELINK_RATE_LIMIT_AUTH_PER_MINUTE=10
# CRIMELINK_UPLOAD_MAX_BYTES=67108864
# CRIMELINK_MAX_REQUEST_BYTES=73400320
# CRIMELINK_AI_TIMEOUT_S=180
# CRIMELINK_AI_INTERACTIVE_TIMEOUT_S=45
# CRIMELINK_AUDIT_ANCHOR_ENABLED=true
